{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "� Commit & Push",
            "type": "shell",
            "command": "bash auto-push.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "📥 Pull (rebase)",
            "type": "shell",
            "command": "git pull --rebase origin main",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}

